{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Forge Common Hardening Library - Values Schema",
  "type": "object",
  "properties": {
    "resourceQuota": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "bufferPercent": {"type": "integer", "minimum": 0, "maximum": 100},
        "minVpaAgeDays": {"type": "integer", "minimum": 1},
        "cpu": {
          "type": "object",
          "properties": {
            "limits": {"type": "string"},
            "requests": {"type": "string"}
          }
        },
        "memory": {
          "type": "object",
          "properties": {
            "limits": {"type": "string", "pattern": "^[0-9]+(Ei|Pi|Ti|Gi|Mi|Ki|E|P|T|G|M|K)?$"},
            "requests": {"type": "string", "pattern": "^[0-9]+(Ei|Pi|Ti|Gi|Mi|Ki|E|P|T|G|M|K)?$"}
          }
        },
        "pods": {"type": ["integer", "null"], "minimum": 1},
        "persistentvolumeclaims": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "workloads": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type"],
        "properties": {
          "name": {"type": "string"},
          "type": {"type": "string", "enum": ["Deployment", "StatefulSet", "DaemonSet"]},
          "replicas": {"type": "integer", "minimum": 0},
          "cpuLimit": {"type": "string"},
          "memoryLimit": {"type": "string"},
          "hpa": {
            "type": "object",
            "properties": {
              "enabled": {"type": "boolean"},
              "maxReplicas": {"type": "integer", "minimum": 1}
            }
          },
          "vpa": {
            "type": "object",
            "properties": {
              "enabled": {"type": "boolean"},
              "upperBound": {"type": "string"},
              "memoryUpperBound": {"type": "string"},
              "ageDays": {"type": "integer", "minimum": 0}
            }
          },
          "pdb": {
            "type": "object",
            "properties": {
              "enabled": {"type": "boolean"},
              "minAvailable": {"type": "integer", "minimum": 0}
            }
          }
        }
      }
    },
    "maxNodes": {"type": "integer", "minimum": 1},
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "namespaceType": {
          "type": "string",
          "enum": ["application", "middleware", "forge-jobs", "forge-operator", "admin", "platform"]
        },
        "allowInternalTraffic": {"type": "boolean"}
      }
    }
  }
}
