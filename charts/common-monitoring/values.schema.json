{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Forge Common Monitoring Configuration",
  "description": "JSON Schema for validating monitoring library chart configuration",
  "type": "object",
  "properties": {
    "monitoring": {
      "type": "object",
      "properties": {
        "prometheusrule": {
          "type": "object",
          "properties": {
            "namespace": {"type": "string"},
            "enabled": {"type": "boolean"},
            "name": {"type": "string"},
            "prometheus": {"type": "string"},
            "role": {"type": "string"},
            "labels": {"type": "object"},
            "annotations": {"type": "object"},
            "groups": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {"type": "string"},
                  "interval": {"type": "string"},
                  "rules": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "alert": {"type": "string"},
                        "expr": {"type": "string"},
                        "for": {"type": "string"},
                        "labels": {"type": "object"},
                        "annotations": {"type": "object"}
                      },
                      "required": ["alert", "expr"]
                    }
                  }
                },
                "required": ["name", "rules"]
              }
            }
          }
        },
        "alerts": {
          "type": "object",
          "properties": {
            "availability": {
              "type": "object",
              "properties": {
                "enabled": {"type": "boolean"},
                "downFor": {"type": "string"},
                "errorRateThreshold": {"type": "number", "minimum": 0, "maximum": 1},
                "errorFor": {"type": "string"},
                "errorSeverity": {"type": "string", "enum": ["info", "warning", "critical"]},
                "latencyThreshold": {"type": "number", "minimum": 0},
                "latencyFor": {"type": "string"},
                "latencySeverity": {"type": "string", "enum": ["info", "warning", "critical"]},
                "successRateThreshold": {"type": "number", "minimum": 0, "maximum": 1},
                "successFor": {"type": "string"}
              }
            },
            "resources": {
              "type": "object",
              "properties": {
                "enabled": {"type": "boolean"},
                "cpuThreshold": {"type": "number", "minimum": 0, "maximum": 1},
                "cpuFor": {"type": "string"},
                "cpuSeverity": {"type": "string", "enum": ["info", "warning", "critical"]},
                "memoryThreshold": {"type": "number", "minimum": 0, "maximum": 1},
                "memoryFor": {"type": "string"},
                "memorySeverity": {"type": "string", "enum": ["info", "warning", "critical"]},
                "restartRateThreshold": {"type": "number", "minimum": 0},
                "restartFor": {"type": "string"},
                "notReadyFor": {"type": "string"},
                "replicaMismatchFor": {"type": "string"}
              }
            },
            "slo": {
              "type": "object",
              "properties": {
                "enabled": {"type": "boolean"},
                "availabilityTarget": {"type": "number", "minimum": 0, "maximum": 1},
                "latencyTarget": {"type": "number", "minimum": 0}
              }
            }
          }
        },
        "grafana": {
          "type": "object",
          "properties": {
            "dashboard": {
              "type": "object",
              "properties": {
                "namespace": {"type": "string"},
                "enabled": {"type": "boolean"},
                "name": {"type": "string"},
                "json": {"type": "string"},
                "labels": {"type": "object"},
                "annotations": {"type": "object"}
              }
            },
            "dashboards": {
              "type": "object",
              "properties": {
                "application": {
                  "type": "object",
                  "properties": {
                    "enabled": {"type": "boolean"}
                  }
                },
                "infrastructure": {
                  "type": "object",
                  "properties": {
                    "enabled": {"type": "boolean"}
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
